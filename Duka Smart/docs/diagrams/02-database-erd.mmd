erDiagram
  USERS ||--o{ BUSINESSES : owns
  BUSINESSES ||--o{ CATEGORIES : has
  BUSINESSES ||--o{ PRODUCTS : stocks
  CATEGORIES ||--o{ PRODUCTS : groups
  BUSINESSES ||--o{ SALES : records
  SALES ||--|{ SALE_ITEMS : contains
  PRODUCTS ||--o{ SALE_ITEMS : sold_as
  BUSINESSES ||--o{ EXPENSES : pays
  BUSINESSES ||--o{ SUPPLIERS : buys_from
  BUSINESSES ||--o{ MPESA_PAYMENTS : receives
  USERS {
    int id PK
    string name
    string email
    string password_hash
    string phone
    text avatar
  }
  BUSINESSES {
    int id PK
    int owner_id FK
    string name
    string location
  }
  CATEGORIES {
    int id PK
    int business_id FK
    string name
  }
  PRODUCTS {
    int id PK
    int business_id FK
    int category_id FK
    string name
    string sku
    string barcode
    int quantity
    int min_stock
    decimal price
    decimal cost_price
  }
  SALES {
    int id PK
    int business_id FK
    string payment_method
    decimal total
    datetime created_at
  }
  SALE_ITEMS {
    int id PK
    int sale_id FK
    int product_id FK
    int quantity
    decimal unit_price
    decimal cost_price
  }
  EXPENSES {
    int id PK
    int business_id FK
    string description
    string category
    decimal amount
    date date
  }
  SUPPLIERS {
    int id PK
    int business_id FK
    string name
    string phone
    int delivery_days
    string notes
  }
  MPESA_PAYMENTS {
    string checkout_request_id PK
    int business_id FK
    string phone
    int amount
    string status
    string receipt
    datetime created_at
  }
